#!/bin/bash
# proxy-destination: 显示流量去向（目标域名 + 访问应用及今日用量）
# 用于 DMS ProxyTraffic 插件
#
# 目标域名来自 xray 的 access 日志（需在代理配置中开启 access 日志）
# 应用及用量来自 ss (iproute2) 的 TCP socket 计数；每次刷新采样一次
# （默认 2 秒），按本地日期累计到状态文件，连接关闭后仍保留当天的用量。
#
# 输出格式:
# {
#   "destinations": [{"domain":"github.com","count":3}, ...],
#   "processes": [
#     {"name":"chrome","count":2,"up":123,"down":456,"total":579}, ...
#   ]
# }
#
# 注意: 只统计本机到代理端口的 TCP 连接；UDP、直连流量以及连接关闭前
# 最后一次采样之后的数据不会计入。应用用量为近似值。

umask 077

XRAY_ACCESS="${XRAY_ACCESS:-}"
PROXY_PORT="${PROXY_PORT:-7890}"
SS_BIN="${SS_BIN:-ss}"
STATE_FILE="${APP_USAGE_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/dms-proxy-traffic/app-usage.json}"

# The settings field passes its value literally; accept a leading ~/.
case "$XRAY_ACCESS" in
    "~/"*) XRAY_ACCESS="$HOME/${XRAY_ACCESS#\~/}" ;;
esac

# 聚合目标域名: 从 access 日志取 [socks -> proxy] 的目标 (最近 N 行)
aggregate_destinations() {
    local lines=()
    if [ -f "$XRAY_ACCESS" ]; then
        lines=$(tail -n 500 "$XRAY_ACCESS" \
            | grep '\[socks -> proxy\]' \
            | grep -oE 'accepted [^ ]+' \
            | sed -E 's#^accepted (https?|tcp|udp)://##; s#^accepted (tcp|udp):##; s#^accepted ##; s#^//##' \
            | awk -F'[/:]' '{print $1}' \
            | grep -E '^[a-zA-Z0-9.-]+$')
    fi

    if [ -z "$lines" ]; then
        return 0
    fi

    # 聚合计数 (取前 10 个)
    echo "$lines" | sort | uniq -c | sort -rn | head -10 \
        | awk '{printf "{\"domain\":\"%s\",\"count\":%d},", $2, $1}'
}

# 从 ss 提取本机应用 -> 代理端口的 TCP 连接:
#   key <TAB> 应用名 <TAB> bytes_sent <TAB> bytes_received
#
# ss -i 的每个 socket 通常有两行:
#   ESTAB ... 127.0.0.1:port 127.0.0.1:proxy users:(("chrome",pid=...))
#       ... bytes_sent:123 bytes_received:456 ...
# 用 key 区分连接，避免把不同应用的连接合并。
aggregate_sockets() {
    "$SS_BIN" -H -tinp "dport = :$PROXY_PORT" 2>/dev/null | awk '
        function emit() {
            if (key != "" && name != "" && have_bytes) {
                printf "%s\t%s\t%d\t%d\n", key, name, sent, recv
            }
            key = ""
            name = ""
            sent = 0
            recv = 0
            have_bytes = 0
        }

        /users:\(\(/ {
            # 新连接行；上一行若没有 TCP info 则丢弃
            emit()
            key = $4 ">" $5
            name = $0
            sub(/.*users:\(\(/, "", name)
            sub(/^"/, "", name)
            sub(/".*/, "", name)
            if (name != "") {
                have_bytes = 0
            }
        }

        /bytes_sent:/ {
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^bytes_sent:/) {
                    value = $i
                    sub(/^bytes_sent:/, "", value)
                    sent = value + 0
                } else if ($i ~ /^bytes_received:/) {
                    value = $i
                    sub(/^bytes_received:/, "", value)
                    recv = value + 0
                }
            }
            if (key != "" && name != "") {
                have_bytes = 1
                emit()
            }
        }
    '
}

# 读取上次状态，损坏时从空状态开始。
state_dir=$(dirname "$STATE_FILE")
mkdir -p "$state_dir" 2>/dev/null || true

base='{"date":"","initialized":false,"apps":{},"sockets":{}}'
if [ -f "$STATE_FILE" ]; then
    loaded=$(jq -c '
        if type == "object"
           and (.apps | type == "object")
           and (.sockets | type == "object")
        then . else empty end
    ' "$STATE_FILE" 2>/dev/null) || loaded=""
    if [ -n "$loaded" ]; then
        base="$loaded"
    fi
fi

today=$(date +%F)
snapshot=$(aggregate_sockets)

if [ -n "$snapshot" ]; then
    current=$(printf '%s\n' "$snapshot" | jq -Rn '
        [inputs
         | split("\t")
         | select(length >= 4)
         | {key: .[0], name: .[1],
            sent: (.[2] | tonumber), recv: (.[3] | tonumber)}]
    ')
else
    current='[]'
fi

# 以 socket 为 key 做差分；第一次看到状态文件时只记录基线，不把
# 插件启动前的 socket 计数算进当天用量。
new_state=$(jq -cn \
    --arg date "$today" \
    --argjson cur "$current" \
    --argjson base "$base" '
    ($base
     | if .date == $date
       then .
       else {date: $date, initialized: false, apps: {}, sockets: {}}
       end) as $b
    | reduce $cur[] as $s (
        {date: $date, initialized: true, apps: $b.apps, sockets: {}};
        ($b.sockets[$s.key] // null) as $prev
        | (if $prev == null
           then
             (if $b.initialized
              then {up: $s.sent, down: $s.recv}
              else {up: 0, down: 0}
              end)
           else
             {up: (if $s.sent >= $prev.sent
                   then $s.sent - $prev.sent
                   else $s.sent
                   end),
              down: (if $s.recv >= $prev.recv
                     then $s.recv - $prev.recv
                     else $s.recv
                     end)}
           end) as $delta
        | .apps[$s.name] =
            ((.apps[$s.name] // {up: 0, down: 0})
             | .up += $delta.up
             | .down += $delta.down)
        | .sockets[$s.key] =
            {name: $s.name, sent: $s.sent, recv: $s.recv}
      )
') || new_state=""

if [ -z "$new_state" ]; then
    new_state='{"date":"","initialized":false,"apps":{},"sockets":{}}'
fi

# 原子写入状态；空闲时没有变化就不重复写盘。
if [ -d "$state_dir" ] && [ "$new_state" != "$base" ]; then
    tmp_state=$(mktemp "$state_dir/.app-usage.XXXXXX" 2>/dev/null) || tmp_state=""
    if [ -n "$tmp_state" ]; then
        if printf '%s\n' "$new_state" > "$tmp_state" \
           && chmod 600 "$tmp_state" \
           && mv -f "$tmp_state" "$STATE_FILE"; then
            :
        else
            rm -f "$tmp_state"
        fi
    fi
fi

processes=$(jq -cn --argjson state "$new_state" --argjson cur "$current" '
    ($cur
     | group_by(.name)
     | map({key: .[0].name, value: length})
     | from_entries) as $counts
    | ($state.apps
       | to_entries
       | map({
           name: .key,
           count: ($counts[.key] // 0),
           up: .value.up,
           down: .value.down,
           total: (.value.up + .value.down)
         })
       | map(select(.total > 0 or .count > 0))
       | sort_by(-.total)
       | .[:10])
') || processes='[]'

dest="$(aggregate_destinations)"
dest="${dest%,}"

out=$(jq -cn \
    --argjson destinations "[${dest:-}]" \
    --argjson processes "$processes" \
    '{destinations: $destinations, processes: $processes}') \
    || out='{"destinations":[],"processes":[]}'

printf '%s\n' "$out"

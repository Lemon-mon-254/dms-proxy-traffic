#!/bin/bash
# proxy-redirect-stats: 读取 xray /debug/vars 输出 proxy/direct 分流流量 JSON
# 用于 DMS ProxyTraffic 插件 (xray 专用可选项)
#
# 数据来源: xray API inbound (dokodemo-door) 的 expvar HTTP 服务
#   http://127.0.0.1:<PORT>/debug/vars  ->  .stats.outbound.{proxy,direct}.{downlink,uplink}
# 需要 xray config 开启: policy.system.statsOutboundUplink/Downlink (v2rayN 默认已开)
#
# 环境变量:
#   XRAY_API_PORT   xray API 端口 (默认 2551)
#
# 输出格式: {"proxy":{"down":0,"up":0},"direct":{"down":0,"up":0},"ready":true}
#   ready=false 表示端口不可达或非 xray (插件显示"不可用")

XRAY_API_PORT="${XRAY_API_PORT:-2551}"

# 从 xray API 读取; 端口不可达时返回 ready=false
fetch_stats() {
    local out
    out=$(curl -s --max-time 2 "http://127.0.0.1:${XRAY_API_PORT}/debug/vars" 2>/dev/null)
    if [ -z "$out" ]; then
        echo '{"proxy":null,"direct":null,"ready":false}'
        return 1
    fi
    echo "$out"
}

output() {
    local stats="$1" result
    # One jq invocation handles both the availability check and the four
    # fields. stats without .stats.outbound means port unreachable / not xray.
    result=$(printf '%s' "$stats" | jq -c '
        if .stats.outbound then
            {
                proxy: {
                    down: (.stats.outbound.proxy.downlink // 0),
                    up: (.stats.outbound.proxy.uplink // 0)
                },
                direct: {
                    down: (.stats.outbound.direct.downlink // 0),
                    up: (.stats.outbound.direct.uplink // 0)
                },
                ready: true
            }
        else
            {proxy: null, direct: null, ready: false}
        end
    ' 2>/dev/null) || {
        echo '{"proxy":null,"direct":null,"ready":false}'
        return 1
    }

    printf '%s\n' "$result"
}

stats=$(fetch_stats)
output "$stats"

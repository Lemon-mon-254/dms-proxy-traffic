#!/bin/bash
# 代理流量采样脚本:统计经过 127.0.0.1:2547 的 TCP 流量
# 输出一行 JSON: {"up":字节,"down":字节,"persistent":bool,"conns":N}
# persistent=false 时 up/down 为当前活跃连接的内核累计(连接断开即清零)
# persistent=true 时为 nftables 计数器的历史累计(需配置免密 sudo)

PORT="${PROXY_PORT:-7890}"

try_nft() {
	command -v jq >/dev/null || return 1
	local out
	out=$(sudo -n nft -j list table inet proxy_stat 2>/dev/null) || return 1
	local up down
	up=$(jq --arg c "proxy-up" '[.nftables[].rule?
		| select(.comment? == $c)
		| .expr[] | .counter?.bytes // 0] | add // 0' <<<"$out" 2>/dev/null) || return 1
	down=$(jq --arg c "proxy-down" '[.nftables[].rule?
		| select(.comment? == $c)
		| .expr[] | .counter?.bytes // 0] | add // 0' <<<"$out" 2>/dev/null) || return 1
	printf '{"up":%s,"down":%s,"persistent":true,"conns":0}\n' "${up:-0}" "${down:-0}"
}

try_ss() {
	local line
	line=$(ss -tinH "dport = :$PORT" 2>/dev/null | awk '
		{
			for (i = 1; i <= NF; i++) {
				if ($i ~ /^bytes_sent:/)     { split($i, a, ":"); s += a[2]; n++ }
				if ($i ~ /^bytes_received:/) { split($i, a, ":"); r += a[2] }
			}
		}
		END { printf "%d %d %d", s + 0, r + 0, n + 0 }')
	read -r up down conns <<<"$line"
	printf '{"up":%d,"down":%d,"persistent":false,"conns":%d}\n' "$up" "$down" "$conns"
}

try_nft || try_ss
